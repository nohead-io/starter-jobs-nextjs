# Copy this file to .env.local and fill it in.

# A Nohead API key with "Published records only" on, and the records:read,
# assets:read and schema:read scopes.
NOHEAD_API_KEY=

# A search token, from the project's Search tokens page in the web app.
NOHEAD_SEARCH_TOKEN=

# Optional: the site's address, for the links in its RSS feeds, its sitemap
# and its share images.
SITE_URL=
