# Copy this file to .env.local and fill it in.

# A Nohead API key with "Published records only" on, and the records:read,
# assets:read and schema:read scopes.
NOHEAD_API_KEY=

# A search token, from the project's Search tokens page in the web app.
NOHEAD_SEARCH_TOKEN=

# A key for the forms (applications and posted jobs), kept on the server: with
# only the records:write and assets:write scopes, and "Published records only" off.
NOHEAD_FORM_KEY=

# The signing secret of the webhook that refreshes the site when content is
# published (whsec_...).
NOHEAD_WEBHOOK_SECRET=

# Optional: the site's address, for the links in its RSS feeds, its sitemap
# and its share images. On Vercel, the project's production domain is used
# without it.
SITE_URL=
